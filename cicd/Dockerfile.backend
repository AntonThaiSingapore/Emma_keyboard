# Backend image. Built from the REPO ROOT, so COPY paths are repo-relative.
# Contract: EXPOSE 8000, serve GET /health, API under /api.
FROM python:3.12-slim
# Apply Debian security updates on every build: the platform's CVE scan blocks
# promotion for findings the distro has already fixed. Keep this directly under
# FROM so its cache key tracks the base image digest.
RUN apt-get update \
 && apt-get upgrade -y \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY backend/requirements.txt .
# Wheels only: this image has no compiler, so a dep without a wheel should fail
# fast and legibly rather than deep in a source build.
RUN pip install --no-cache-dir --only-binary=:all: -r requirements.txt

COPY backend/ .

ENV PYTHONUNBUFFERED=1
EXPOSE 8000

# The app package lives at backend/app/, so run it as app.main:app with the
# backend dir on the path.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
